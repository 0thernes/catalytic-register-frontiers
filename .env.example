# Optional environment variables for catalytic-register-frontiers.
# No secrets or API keys are used anywhere in this repository.

# Explicit path to the CaDiCaL 2.1.2 binary (auto-detected from Lean 4.35.0 toolchain if unset)
CADICAL_BIN=

# Enforce UTF-8 stdio on Windows consoles
PYTHONUTF8=1

# Optional deterministic timestamp override for reproducible packaging
SOURCE_DATE_EPOCH=1795420800
